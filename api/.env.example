# Booking API non-secret config
BOOKING_API_ALLOWED_ORIGINS=https://www.example.com,https://example.com
BOOKING_API_MAX_BODY_BYTES=65536
BOOKING_API_ABUSE_PROTECTION_ENABLED=true
BOOKING_API_CAPTCHA_CHALLENGES_ENABLED=true
BOOKING_API_RATE_LIMIT_MAX_BUCKETS=10000

# CAPTCHA provider for server-side token verification (recaptcha or hcaptcha).
# This MUST match the widget the frontend ships. The frontend uses Google
# reCAPTCHA v3 (react-google-recaptcha-v3 + REACT_APP_CAPTCHA_SITE_KEY), so the
# default is "recaptcha"; verifying a Google token against hCaptcha's endpoint
# always fails, which leaves CAPTCHA challenges permanently unclearable.
CAPTCHA_PROVIDER=recaptcha
# Verification secret. In deployed environments this comes from the combined
# Secrets Manager entry as `captchaSecretKey` — set it here for local dev only.
# With no secret from either source, CAPTCHA-required requests stay at 403.
CAPTCHA_SECRET_KEY=
# CAPTCHA_VERIFY_URL=  # Override only for testing; leave unset to use the provider default.

# PayPal API config. Use sandbox URL for non-production environments.
# Return/cancel URLs are only required for the redirect flow; leave empty when using the JS SDK.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_TIMEOUT_MS=10000
PAYPAL_ORDER_RETURN_URL=
PAYPAL_ORDER_CANCEL_URL=

# Smoobu customer/user ID — required for POST /api/search availability checks.
SMOOBU_CUSTOMER_ID=

# Production/staging/dev deployments should point to AWS Secrets Manager.
# The Lambda runtime also needs the AWS Parameters and Secrets Lambda Extension
# and IAM permission to read this secret.
BOOKING_API_SECRETS_MANAGER_SECRET_ID=booking-engine/dev/booking-api
BOOKING_API_SECRETS_CACHE_TTL_MS=300000
BOOKING_API_SECRETS_FETCH_TIMEOUT_MS=2000

# Local-only escape hatch for isolated tests. Never use for deployed envs.
# BOOKING_API_ALLOW_INSECURE_ENV_SECRETS=true
# BOOKING_API_SECRETS_JSON={"smoobuApiKey":"...","smoobuApiSecret":"...","paypalClientId":"...","paypalClientSecret":"...","paypalWebhookId":"...","smoobuWebhookSecret":"...","bookingEncryptionKeyBase64":"...","portalSessionSecret":"...","rdsConnectionString":"postgres://user:password@host:5432/booking_engine"}
# BOOKING_API_RDS_CONNECTION_STRING=postgres://user:password@host:5432/booking_engine
# BOOKING_API_MIGRATION_SSL=false
# BOOKING_API_MIGRATION_SSL_REJECT_UNAUTHORIZED=false

# SES transactional email config
SES_FROM_ADDRESS=reservations@example.com
SES_REGION=us-east-1
# SES configuration set for delivery tracking (bounces, complaints). Set by Terraform in Lambda env.
# SES_CONFIG_SET=
# Set to true to disable email sending (useful for local dev/test)
EMAIL_DISABLED=false

# Contact info shown in deposit handoff emails.
# If unset, falls back to the hardcoded defaults in emailTemplates.ts.
CONTACT_WHATSAPP_URL=https://wa.me/contact
CONTACT_EMAIL=reservations@example.com

# Manual deposit bank/SINPE details shown to guests paying by bank transfer.
# See depositHandoff.ts — with nothing set, guests see a visible placeholder
# telling staff the deposit flow still needs configuring.
DEPOSIT_BANK_ACCOUNT_HOLDER=
DEPOSIT_BANK_PRIMARY_LABEL=
DEPOSIT_BANK_PRIMARY_ACCOUNT=
DEPOSIT_BANK_SECONDARY_LABEL=
DEPOSIT_BANK_SECONDARY_ACCOUNT=
# Costa Rica SINPE Móvil only — leave unset outside that market.
DEPOSIT_SINPE_PHONE=
DEPOSIT_SINPE_NAME=
# Optional per-property override, as a JSON object keyed by property slug, for
# portfolios that settle different properties into different bank accounts.
# DEPOSIT_BANK_ACCOUNTS_BY_SLUG_JSON={"SunsetVilla":{"accountHolder":"...","primaryAccountLabel":"...","primaryAccount":"..."}}

# S3 deposit receipt upload config.
# Set S3_DEPOSIT_RECEIPT_BUCKET to enable deposit receipt uploads.
# Leave unset to disable the upload endpoints (they return 503).
S3_DEPOSIT_RECEIPT_BUCKET=
S3_DEPOSIT_RECEIPT_REGION=us-east-1
S3_PRESIGNED_PUT_EXPIRY_SECONDS=300
S3_PRESIGNED_GET_EXPIRY_SECONDS=604800
S3_MAX_FILE_SIZE_BYTES=10485760
# Comma-separated MIME types. Defaults to image/jpeg,image/png,image/webp,image/heic,application/pdf
# S3_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/heic,application/pdf

# ── Server-side conversion reporting ─────────────────────────────────────────
# The API is the authoritative source for GA4 funnel events: the Measurement
# Protocol cannot deduplicate, so the browser should not also report search /
# begin_checkout / add_payment_info / purchase. Meta events still fire from both
# sides and collapse on event_id.
#
# With either the ID or its matching secret missing, reporting is simply inert —
# no booking ever fails because conversion reporting is unconfigured.
GA4_MEASUREMENT_ID=
# Create under GA4 Admin → Data streams → Measurement Protocol API secrets.
# In deployed environments this comes from the combined Secrets Manager entry as
# `ga4ApiSecret` — set it here for local dev only.
GA4_API_SECRET=
# Must match REACT_APP_META_PIXEL_ID, or browser and server events will not dedupe.
META_PIXEL_ID=
# Events Manager → Settings → Conversions API → Generate access token.
# Deployed environments read this from Secrets Manager as `metaCapiAccessToken`.
META_CAPI_ACCESS_TOKEN=
# Routes GA4 to the validation endpoint, which returns explicit payload errors.
SERVER_CONVERSIONS_DEBUG=false
# Set to send Meta events to the Test Events tab instead of live data.
META_TEST_EVENT_CODE=
