# Local development overrides for the booking API.
#
#   cp .env.local.example .env.local
#
# scripts/loadEnv.js loads .env first, then this file on top, so these values
# win over any real credentials you keep in .env. Nothing here is secret and
# nothing here is used in AWS.

# ── Local Postgres (docker-compose.yml, at the repo root) ───────────────────
# Port 5433 on the host, to stay clear of any other Postgres on the default 5432.
BOOKING_API_RDS_CONNECTION_STRING=postgres://booking:booking@localhost:5433/booking_engine
# Local Postgres has no TLS; RDS requires it, so this override is local-only.
BOOKING_API_MIGRATION_SSL=false
BOOKING_API_DB_SSL=false

# ── Provider mocks (scripts/mockProviders.js) ────────────────────────────────
# Smoobu has no sandbox: pointing this at the real API would block dates on live
# properties. Leave it on the mock unless you specifically intend otherwise.
SMOOBU_BASE_URL=http://localhost:4010
# PayPal does have a sandbox — swap in https://api-m.sandbox.paypal.com plus real
# sandbox credentials when you want to exercise the genuine redirect flow.
PAYPAL_BASE_URL=http://localhost:4010
# Sent with availability requests. The mock ignores the value, but search refuses
# to run without one.
SMOOBU_CUSTOMER_ID=1

# ── Local-only secrets ───────────────────────────────────────────────────────
# Reading provider secrets from the environment is refused unless explicitly
# allowed, so a deployed environment can never fall back off Secrets Manager.
BOOKING_API_ALLOW_INSECURE_ENV_SECRETS=true

# Secret resolution order is: BOOKING_API_SECRETS_MANAGER_SECRET_ID, then
# BOOKING_API_SECRETS_JSON, then the individual variables below. Blanking these
# two forces the local path even when .env still defines them.
BOOKING_API_SECRETS_MANAGER_SECRET_ID=
BOOKING_API_SECRETS_JSON=

# Fake values so the API boots without Secrets Manager. The encryption key must
# decode to exactly 32 bytes; the portal session secret signs guest portal tokens.
SMOOBU_API_KEY=local-mock-smoobu-key
SMOOBU_API_SECRET=local-mock-smoobu-api-secret
SMOOBU_WEBHOOK_SECRET=local-mock-smoobu-webhook-secret
PAYPAL_CLIENT_ID=local-mock-paypal-client-id
PAYPAL_CLIENT_SECRET=local-mock-paypal-client-secret
PAYPAL_WEBHOOK_ID=local-mock-paypal-webhook-id
BOOKING_API_ENCRYPTION_KEY_BASE64=Ym9va2luZy1sb2NhbC1kZXYtZW5jcnlwdGlvbi0zMjA=
BOOKING_API_PORTAL_SESSION_SECRET=local-dev-portal-session-secret-change-me

# ── Behaviour ────────────────────────────────────────────────────────────────
# Your frontend dev server origin. Adjust to match wherever you run it.
BOOKING_API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
BOOKING_API_LOG_LEVEL=debug
BOOKING_API_METRICS_ENABLED=false
# Emails are logged instead of sent — no SES identity needed locally.
EMAIL_DISABLED=true
STAFF_NOTIFICATION_EMAIL=staff@example.local
# Rate limits and CAPTCHA challenges get in the way of manual testing.
BOOKING_API_ABUSE_PROTECTION_ENABLED=false
BOOKING_API_CAPTCHA_CHALLENGES_ENABLED=false

# ── Deposit receipts (MinIO from docker-compose.yml) ─────────────────────────
S3_DEPOSIT_RECEIPT_BUCKET=booking-deposit-receipts
S3_DEPOSIT_RECEIPT_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=booking
AWS_SECRET_ACCESS_KEY=booking-local-secret

# ── Dev server ───────────────────────────────────────────────────────────────
BOOKING_API_DEV_PORT=4000
MOCK_PROVIDERS_PORT=4010

# ── Manual deposit ───────────────────────────────────────────────────────────
DEPOSIT_HOLD_TTL_HOURS=36
DEPOSIT_CONFIRM_TOKEN_TTL_HOURS=168
# Base URL the signed staff confirmation link points at (the API, not the site).
DEPOSIT_STAFF_CONFIRM_BASE_URL=http://localhost:4000
# Example account so the deposit flow has something to display locally.
DEPOSIT_BANK_ACCOUNT_HOLDER=Local Test Holdings LLC
DEPOSIT_BANK_PRIMARY_LABEL=USD account
DEPOSIT_BANK_PRIMARY_ACCOUNT=ACC-LOCAL-0001

# ── Server-side conversion reporting ─────────────────────────────────────────
# Leave blank locally: with no IDs/secrets the reporter is inert, so local
# bookings never reach a production GA4 property or Meta dataset.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
SERVER_CONVERSIONS_DEBUG=false
META_TEST_EVENT_CODE=
